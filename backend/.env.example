PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only. This must never be exposed to browser JavaScript or frontend env files.
ADMIN_API_KEY=replace-with-admin-api-key

# Local development only. Never use a production secret here.
ADMIN_DEV_TOKEN=replace-with-local-dev-admin-token
